pipeline {
    agent any

    environment {
        IMAGE_NAME = 'springboot-docker-demo'
        CONTAINER_NAME = 'springboot-docker-demo'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out by Jenkins'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn -B clean test'
            }
        }

        stage('Package') {
            steps {
                bat 'mvn -B package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %IMAGE_NAME%:%BUILD_NUMBER% .'
                bat 'docker tag %IMAGE_NAME%:%BUILD_NUMBER% %IMAGE_NAME%:latest'
            }
        }

        stage('Deploy Locally') {
            steps {
                bat 'docker rm -f %CONTAINER_NAME% 2>NUL || exit /B 0'
                bat 'docker run -d --name %CONTAINER_NAME% -p 8080:8080 --restart unless-stopped %IMAGE_NAME%:latest'
            }
        }
    }

    post {
        success {
            echo 'Build, tests, Docker image creation, and local deployment completed.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }
    }
}
